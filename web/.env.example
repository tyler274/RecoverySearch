# Copy to .env.local and fill in values from the root Supabase .env.
# direnv loads .env.local automatically (see .envrc).

# Kong gateway (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from root .env>

# Server-only — import script + admin server actions. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from root .env>

# Direct Postgres URL for Supabase CLI (db push / gen types), via the pooler.
# Host 5433 -> pooler -> db. User: postgres.<POOLER_TENANT_ID>, pwd: POSTGRES_PASSWORD.
SUPABASE_DB_URL=postgresql://postgres.your-tenant-id:<POSTGRES_PASSWORD>@localhost:5433/postgres?sslmode=disable
