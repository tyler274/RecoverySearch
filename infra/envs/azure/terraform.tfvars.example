# Copy to terraform.tfvars and fill in. Also export ARM_SUBSCRIPTION_ID
# (or run `az login`) so the azurerm provider knows the subscription.

name_prefix    = "recoverysearch"
region         = "eastus"
instance_size  = "Standard_D2s_v5"
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Lock these down to your IP in production.
ssh_allowed_cidr = "0.0.0.0/0"
web_allowed_cidr = "0.0.0.0/0"

# The VM clones this repo at boot.
app_repo_url = "https://github.com/your-org/RecoverySearch.git"
app_repo_ref = "main"

# ----- Secrets backend: choose one -----
secrets_backend = "vault" # "vault" | "doppler" | "cloud_native"

# Vault (secrets_backend = "vault"). VAULT_TOKEN can come from the env instead.
vault_address = "https://vault.example.com:8200"
# vault_token = "hvs...."

# Doppler (secrets_backend = "doppler").
# doppler_token   = "dp.pt...."
# doppler_project = "recoverysearch"
# doppler_config  = "prd"

# cloud_native uses Azure Key Vault and needs no extra secret config.

# Optional DNS (existing zone).
# dns_zone_name           = "example.com"
# dns_zone_resource_group = "dns-rg"
# dns_record_name         = "app"
